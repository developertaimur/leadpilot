# Fake values for `npm test`. Loaded by node --env-file before any code runs,
# so dotenv in src/config/env.js will not override them with the real .env.
DATABASE_URL="mysql://test:test@127.0.0.1:1/leadpilot_test"
OPENWA_BASE_URL=http://127.0.0.1:1
OPENWA_API_KEY=test-openwa-api-key
OPENWA_SESSION_ID=test-openwa-session-id
OPENWA_WEBHOOK_SECRET=test-openwa-webhook-secret
BATCH_DELAY_SECONDS=7
BATCH_DAILY_CAP=5
BATCH_MAX_CONSECUTIVE_FAILURES=2
GEMINI_API_KEY=test-gemini-key
GROQ_API_KEY=test-groq-key
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./test/does-not-exist.json
DEFAULT_PHONE_REGION=PK
# Silence dotenv's "injected env" log lines during tests.
DOTENV_CONFIG_QUIET=true
